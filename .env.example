# VITE_API_URL — переопределяет baseURL для API-запросов во время сборки.
# Если не задан, фронтенд использует относительный путь /api,
# который nginx проксирует на backend-контейнер (см. nginx.conf).
# Обычно оставлять пустым при деплое через docker-compose.
# VITE_API_URL=https://api.example.com/api
