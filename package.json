    "primeicons": "^6.0.1",
    "primevue": "^3.47.2",
    "sass": "^1.77.4",
    "vue": "^3.5.30",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@vite-pwa/assets-generator": "^0.2.4",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.3",
    "typescript": "^5.9.3",
    "vite": "^5.0.11",
